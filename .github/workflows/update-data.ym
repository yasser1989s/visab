name: Check & Update Visa Bulletin

on:
  schedule:
    # Runs daily at 14:00 UTC between days 8 and 18 of every month
    - cron: '0 14 8-18 * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-bulletin:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        run: |
          pip install requests beautifulsoup4

      - name: Execute Scraper
        run: |
          python scripts/scraper.py

      - name: Commit and Push Changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add data/current_bulletin.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update Visa Bulletin records [skip ci]" && git push)
