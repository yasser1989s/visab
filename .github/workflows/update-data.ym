name: Check, Parse & Generate AI Visa Bulletin

on:
  schedule:
    # Runs twice daily at 13:00 and 19:00 UTC between days 8 and 18 of every month
    - cron: '0 13,19 8-18 * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  run-pipeline:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install Dependencies
        run: |
          pip install requests beautifulsoup4

      - name: Run Scraper & AI Insights
        env:
          AI_API_KEY: ${{ secrets.AI_API_KEY }}
        run: |
          python scripts/scraper.py

      - name: Commit and Push Updated Data
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add data/current_bulletin.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-sync bulletin dates & AI forecasts [skip ci]" && git push)
